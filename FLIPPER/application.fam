App(
    appid="lab_c5",
    name="[GPIO] C5 Lab",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="Lab_C5_app",
    stack_size=8 * 1024,
    order=90,
    fap_icon="gfx/icon.png",
    fap_icon_assets="gfx",
    fap_category="GPIO",
    fap_author="Lab_Team",
    fap_description="WiFi Deauther controller for Lab_C5 module via UART",
    sources=["Lab_C5.c", "module_loader.c", "attack_rx_guard.c", "modules/recon/recon_targets.c"],
)

App(
    appid="lab_c5_gps",
    apptype=FlipperAppType.PLUGIN,
    entry_point="lab_c5_gps_plugin_ep",
    requires=["lab_c5"],
    sources=["modules/gps/gps_module.c", "gps_coord.c"],
    fal_embedded=True,
)

